{
  "version": 2,
  "builds": [
    {
      "src": "backend_cloud_code/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "next.config.js",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "^/api/triggers/verificar$",
      "dest": "backend_cloud_code/server.js"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1"
    },
    {
      "src": "/webhook/(.*)",
      "dest": "backend_cloud_code/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/triggers/verificar",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/etiquetas/financeiro/drenar",
      "schedule": "30 5 * * *"
    }
  ]
}
